# Redraw the dashboard every minute (for the clock), and once shortly after boot.
# Weather, air and tide data are reused between redraws; see [refresh] in config.toml.
[Unit]
Description=Rebuild Kindle dashboard every minute

[Timer]
OnBootSec=1min
OnCalendar=*:*:00
AccuracySec=1s
Persistent=true

[Install]
WantedBy=timers.target
